# --- Postgres (docker-compose) ---
POSTGRES_USER=planning_poker
POSTGRES_PASSWORD=planning_poker
POSTGRES_DB=planning_poker
POSTGRES_PORT=5432

# --- API ---
PORT=4000
DATABASE_URL=postgresql://planning_poker:planning_poker@localhost:5432/planning_poker
# Comma-separated list of browser origins allowed to call the API (REST and Socket.io alike).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# How long a dropped socket keeps its seat marked online before it counts as having left the
# room. A short window means a reload or a brief network blip is not a departure (PRD §12).
SOCKET_DISCONNECT_GRACE_MS=5000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- NextAuth (apps/web) ---
# The web app reads DATABASE_URL too: NextAuth's Postgres adapter uses the same database as the API.
NEXTAUTH_URL=http://localhost:3000
# Read by apps/api as well: the API verifies NextAuth's session cookie with this same secret,
# which is how it tells a signed-in caller from a guest. They must match.
NEXTAUTH_SECRET=change-me-in-local-and-production
# Optional: leave empty to run with email/password sign-in only (the Google button disappears).
# Authorized redirect URI for the OAuth client: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
