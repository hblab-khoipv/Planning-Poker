# Config for deploy/scripts/push-from-laptop.sh — the build-and-ship half of the hand deploy.
# Runs on the OPERATOR'S LAPTOP.
#
#   cp deploy/env/laptop-push.env.example deploy/env/laptop-push.env
#
# Every key here is exported over whatever is already in the environment: this file is the
# authority, so `SKIP_BUILD=true bash push-from-laptop.sh` will not win against a line below.

# --- where the box is ---------------------------------------------------------------------
# The INSTANCE, not the load balancer: the ALB terminates HTTPS and does not forward SSH.
# An Elastic IP, or a DNS name pointing at the instance.
SSH_HOST=REPLACE_ME
# Amazon Linux AMIs use ec2-user; Ubuntu AMIs use ubuntu.
SSH_USER=ec2-user
# Path to the private key. Leave empty to use ssh-agent / ~/.ssh/config.
SSH_KEY=
SSH_PORT=22
# Where the release tree lands on the box. The whole directory is kept in sync with --delete,
# except deploy/env/, node_modules/ and .deploy-run/, which belong to the box.
REMOTE_PATH=/home/ec2-user/api

# --- what the browser bundle is built to call ----------------------------------------------
# BAKED INTO THE BROWSER BUNDLE AT BUILD TIME. Changing it later — in web.env, on the box,
# anywhere — does nothing until you rebuild and push again. This is the single most expensive
# mistake on this deployment.
NEXT_PUBLIC_API_URL=https://api.planningpoker.hblab.dev

# --- behaviour -----------------------------------------------------------------------------
# true: ssh in and run deploy/scripts/restart-on-box.sh after the upload.
REMOTE_RESTART=true
# true reuses the existing dist/ and .next/ instead of npm ci && npm run build. Leave false;
# a skipped build is how a stale NEXT_PUBLIC_API_URL gets shipped.
SKIP_BUILD=false
# Where the release tree is assembled locally (deploy/scripts/stage-release.sh).
#STAGE_DIR=/tmp/planning-poker-stage
# Extra rsync flags, space separated, e.g. --exclude 'apps/web/.next/cache'
RSYNC_EXTRA_ARGS=
