# Config for deploy/scripts/restart-on-box.sh — the on-the-box half of the hand deploy.
# Lives ON THE BOX and is never overwritten by a push (rsync excludes deploy/env/).
#
#   cp deploy/env/box-restart.env.example deploy/env/box-restart.env
#
# Everything here has a working default; edit only what differs on your box. The three files the
# apps themselves read — api.env, web.env, postgres.env — live next to this one and are NOT
# described here; see docs/deployment.md §4 for their keys.

# Where api.env / web.env / postgres.env live. Default: <repo>/deploy/env
#ENV_DIR=/home/ec2-user/api/deploy/env

# Ports the two apps listen on. These are also the ALB target-group ports. API_PORT must match
# PORT in api.env — that is what apps/api/src/config.ts actually reads.
API_PORT=4000
WEB_PORT=3000

# Minimum major Node version the script insists on before building.
NODE_MAJOR=22

# auto | systemd | background
#   auto       — use systemd when both units are installed, otherwise background processes
#   systemd    — require the units (fail if they are missing)
#   background — always plain nohup processes (survive the shell, NOT a reboot)
SERVICE_MODE=auto
SYSTEMD_API_UNIT=planning-poker-api
SYSTEMD_WEB_UNIT=planning-poker-web

# Where background-mode pidfiles and logs go. Default: <repo>/.deploy-run
#RUN_DIR=/home/ec2-user/api/.deploy-run
#LOG_DIR=/home/ec2-user/api/.deploy-run/logs
# RUN_DIR also holds the checksum of the manifests from the last run, which is how the script
# decides whether `npm ci --omit=dev` has to run again.

# The docker-compose service that runs Postgres, and how long to wait for it.
COMPOSE_SERVICE=postgres
POSTGRES_WAIT_SECONDS=60

# How long each health check keeps retrying before the deploy is declared failed.
HEALTH_WAIT_SECONDS=90

# true forces `npm ci --omit=dev` even when package.json/package-lock.json are unchanged.
# This script never builds — the laptop does (deploy/scripts/push-from-laptop.sh).
FORCE_INSTALL=false

# NOTE: every key in this file is exported over whatever is already in the environment, so the
# file is the authority. For a one-off override, edit the file or point DEPLOY_ENV_FILE at a
# second copy — `FORCE_INSTALL=true bash restart-on-box.sh` will NOT win against a line here.
