# Nginx reverse proxy for the single-EC2 Planning Poker deployment.
#
# Install at /etc/nginx/sites-available/planning-poker with __APP_DOMAIN__ substituted
# (deploy/scripts/bootstrap-server.sh does that), then symlink into sites-enabled.
#
# Why two hostnames instead of one: the web app serves /rooms/:code as an HTML page and the API
# serves /rooms/:code as JSON, so a single host cannot route both by path. The API therefore gets
# api.__APP_DOMAIN__, and AUTH_COOKIE_DOMAIN=.__APP_DOMAIN__ is what keeps NextAuth's session
# cookie reaching it (apps/web/src/server/auth/cookie-domain.ts). One certbot certificate covers
# both names.

upstream planning_poker_web { server 127.0.0.1:3000; keepalive 16; }
upstream planning_poker_api { server 127.0.0.1:4000; keepalive 16; }

# --- Web (Next.js) ------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name __APP_DOMAIN__ api.__APP_DOMAIN__;

    # certbot's http-01 challenge must stay on :80 and unredirected.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __APP_DOMAIN__;

    # Managed by certbot (deploy/scripts/bootstrap-server.sh runs it once; renewal is a timer).
    ssl_certificate     /etc/letsencrypt/live/__APP_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__APP_DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://planning_poker_web;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }
}

# --- API (Express + Socket.io) ------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.__APP_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__APP_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__APP_DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Socket.io: the WebSocket upgrade needs Upgrade/Connection passed through verbatim, and the
    # read timeout has to outlive the engine.io ping interval or idle rooms get dropped.
    location /socket.io/ {
        proxy_pass http://planning_poker_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout  600s;
        proxy_send_timeout  600s;
        proxy_buffering     off;
    }

    location / {
        proxy_pass http://planning_poker_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        # The API answers CORS itself (config.corsOrigin); nginx must not add a second header.
    }
}
